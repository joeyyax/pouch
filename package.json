{
  "name": "pouch",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm gen:observations && next dev --turbopack --port 3100",
    "dev:worker": "tsx watch worker/index.ts",
    "dev:smtp": "tsx watch smtp/index.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "dev:all": "pnpm bootstrap && concurrently -n app,worker,smtp -c blue,magenta,cyan \"pnpm dev\" \"pnpm dev:worker\" \"pnpm dev:smtp\"",
    "build": "pnpm gen:observations && next build",
    "start": "scripts/start.sh",
    "worker": "tsx worker/index.ts",
    "smtp": "tsx smtp/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:docs": "tsx scripts/check-api-docs.ts",
    "gen:observations": "node scripts/gen-observations.mjs",
    "test": "node scripts/gen-observations.mjs --check && pnpm typecheck && pnpm lint && pnpm check:docs && vitest run",
    "test:unit": "vitest run --project unit",
    "test:load": "vitest run --config vitest.load.config.ts",
    "build:sdk": "tsx scripts/build-sdk.ts",
    "release:sdk": "tsx scripts/release-sdk.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "reset:admin": "tsx scripts/reset-admin.ts",
    "dev:data": "tsx scripts/dev-data.ts",
    "dev:reset": "tsx scripts/dev-data.ts reset && tsx scripts/dev-data.ts",
    "shadcn": "pnpm dlx shadcn@4.21.1",
    "uikit": "node scripts/uikit.mjs",
    "design:shots": "node scripts/design-shots.mjs",
    "design:flows": "node scripts/design-flows.mjs",
    "design:focus": "node scripts/design-focus.mjs",
    "brand:assets": "tsx scripts/brand-assets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1134.0",
    "@aws-sdk/client-eventbridge": "^3.1134.0",
    "@aws-sdk/client-iam": "^3.1134.0",
    "@aws-sdk/client-route-53": "^3.1130.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-ses": "^3.1142.0",
    "@aws-sdk/client-sesv2": "^3.1127.0",
    "@aws-sdk/client-sns": "^3.1127.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/passkey": "^1.7.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/render": "2.1.0",
    "@sentry/node": "^10.74.0",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.2",
    "framer-motion": "^12.43.0",
    "highlight.js": "^11.12.0",
    "ioredis": "^5.10.1",
    "mailparser": "^3.9.24",
    "nanoid": "^5.1.9",
    "next": "^16.3.8",
    "nodemailer": "^10.0.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "6.11.0",
    "recharts": "^3.10.1",
    "smtp-server": "^3.19.10",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.16",
    "tsx": "^4.23.13",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sentry/core": "^10.74.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/smtp-server": "^3.5.13",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
