# App
APP_URL=http://localhost:3100
# Where system mail comes from until an operator sets one in Admin settings.
SUPPORT_ADDRESS=support@example.org
NEXT_PUBLIC_APP_URL=http://localhost:3100
PORT=3100
LOG_LEVEL=info

# Failed authentications allowed per minute from one address.
FAILED_AUTH_RATE_LIMIT=20

# Password reset requests allowed per minute from one client address, and for one email address.
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_EMAIL_RATE_LIMIT=3
# Sign-in link requests allowed per minute from one client address, and for one email address.
MAGIC_LINK_RATE_LIMIT=5
MAGIC_LINK_EMAIL_RATE_LIMIT=3

# Invitations allowed per minute for one organization, and to one invited address.
# INVITE_RATE_LIMIT=10
# INVITE_EMAIL_RATE_LIMIT=3

# Concurrent SSE streams one key may hold open, across GET /v1/emails/:id/events and
# GET /v1/events combined.
MAX_CONCURRENT_STREAMS_PER_KEY=10

# Error reporting (GlitchTip, Sentry-compatible). Unset means off — local dev and tests never
# report. Set GLITCHTIP_ENVIRONMENT to tell staging events apart from production.
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=
# The release an error report carries. The image sets it from the GIT_SHA build arg.
# GIT_SHA=

# Operator alerts (ntfy). Unset NTFY_TOPIC means push is off — an alert logs a warning and skips
# rather than throwing. NTFY_URL defaults to https://ntfy.sh; point it at a self-hosted server
# instead, and set NTFY_TOKEN only if that server requires auth.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Domain blocklist checks through Spamhaus DQS. Unset means off. The free key covers
# non-commercial use under 100,000 queries a day; Pouch stops at 90,000.
SPAMHAUS_DQS_KEY=

# The settings file. The variables below win over it. Defaults to pouch.yml in the working directory. See pouch.example.yml.
# CONFIG_FILE=pouch.yml

# Pins an optional feature on (true) or off (false), over Admin settings → General. Unset leaves it to the admin.
FEATURE_BULK=
FEATURE_LISTS=
FEATURE_INBOUND=
FEATURE_ADDRESSES=
FEATURE_OBSERVATIONS=
FEATURE_DMARC_REPORTS=
FEATURE_MCP=
# The largest message, body and decoded attachments, 1 to 30 MB. Unset leaves it to the admin, 30 by default.
MAX_MESSAGE_MB=
# Requests a minute a new key gets when it's created without one, 1 to 10000. Unset leaves it to the admin, 3000 by default.
KEY_RATE_LIMIT_DEFAULT=
# Active addresses per organization and messages per address a day, unless an admin set the organization's own.
# Unset leaves them to the admin, 500 and 100 by default.
ADDRESS_LIMIT_DEFAULT=
ADDRESS_DAILY_MESSAGE_LIMIT_DEFAULT=
# The most days an organization can keep bodies readable, 7 to 730. Unset leaves it to the admin, 365 by default.
BODY_RETENTION_MAX_DAYS=
# The most days a domain can hold inbound mail, 1 to 365. Unset leaves it to the admin, 30 by default.
INBOUND_RETENTION_MAX_DAYS=
# Days the activity log keeps setup changes, 365 to 1825, and routine events, 7 to 730. Sign-ins stay at least 90.
# Unset leaves them to the admin, 730 and 90 by default.
ACTIVITY_RETENTION_DAYS=
ACTIVITY_CHURN_RETENTION_DAYS=
# Pins a sign-in method on (true) or off (false). All three off leaves the password on.
SIGN_IN_PASSWORD=
SIGN_IN_PASSKEY=
SIGN_IN_MAGIC_LINK=
# Days a session lasts without use, 1 to 90, read when the app starts. Unset leaves it to the admin, 7 by default.
SESSION_DAYS=
# Who creates organizations from the dashboard: closed (admins), owners (admins and organization owners) or open (anyone signed in, the default).
ORGANIZATION_CREATION=

# Where the stall guard holds a domain's queue, over Admin settings → General. Each goes lower than its default,
# never higher: 2.5 and 0.05 percent, 3 bounces, from 10 resolved messages. Unset leaves it to the admin.
STALL_BOUNCE_PERCENT=
STALL_COMPLAINT_PERCENT=
STALL_BOUNCE_COUNT=
STALL_COUNT_VOLUME_FLOOR=

# Turns a notification type off (false) for every owner on the install, over Admin settings → General. Unset leaves it to the admin, on by default.
NOTIFICATION_STANDING_AT_RISK=
NOTIFICATION_STANDING_PAUSED=
NOTIFICATION_STANDING_RESUMED=
NOTIFICATION_ACCOUNT_TARGETED=
NOTIFICATION_TAG_QUIET=
NOTIFICATION_DOMAIN_SPOOFED=
NOTIFICATION_DELIVERY_TIME=
NOTIFICATION_DMARC_POLICY_READY=
# Hours before owners are emailed about the same standing again, 1 to 168. A worse standing always emails. Unset leaves it to the admin, 24 by default.
STANDING_ALERT_REPEAT_HOURS=
# Minutes a provider backs off with no successful send before admins get an alert, 15 to 1440. Unset leaves it to the admin, 30 by default.
PROVIDER_BACKOFF_ALERT_MINUTES=
# The UTC hour admins' digests send, 0 to 23. Unset leaves it to the admin, 0 by default.
DIGEST_HOUR=

# Postgres and Redis, matching docker-compose.yml
DATABASE_URL=postgresql://mail:mail@localhost:5440/mail
# Postgres connections each process holds. Defaults to 10.
# DATABASE_POOL_MAX=
REDIS_URL=redis://localhost:6390
# Prefixes every Redis key. Tests set one per checkout.
# REDIS_KEY_PREFIX=

# Session signing. Development value below; generate a real one for any deployment with
# openssl rand -base64 32
BETTER_AUTH_SECRET=pouch-development-only-session-secret

# Provider credential encryption, 32 bytes of base64. openssl rand -base64 32
# Rotating this makes stored provider credentials undecryptable, so the development value is
# fixed rather than per-developer.
ENCRYPTION_KEY=cG91Y2gtZGV2ZWxvcG1lbnQtb25seS1rZXktMzJieXQ=

# Object storage. MinIO locally, R2 in production. STORAGE_BUCKET is private: bodies and
# attachments, no public domain, ever.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_BUCKET=mail-bodies
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Public bucket for per-domain layout assets, served from its own domain. Both unset means
# the assets store is unconfigured.
STORAGE_ASSETS_BUCKET=
STORAGE_ASSETS_BASE_URL=

# Worker
WORKER_HEALTH_PORT=3101
WORKER_CONCURRENCY=32
WORKER_POLL_INTERVAL_MS=2000
WORKER_VERIFY_INTERVAL_MS=60000
WORKER_VERIFY_BATCH=20
WORKER_VERIFY_RECHECK_MS=300000
WORKER_VERIFY_SLOW_RECHECK_MS=3600000
WORKER_VERIFY_PENDING_EXPIRES_MS=1209600000
WORKER_STALL_GUARD_INTERVAL_MS=60000
WORKER_STALL_GUARD_BATCH=50
WORKER_STALL_GUARD_RECHECK_MS=300000
SHUTDOWN_HOOK_TIMEOUT_MS=8000
SHUTDOWN_DRAIN_TIMEOUT_MS=75000

# Mailpace
MAILPACE_API_BASE=https://app.mailpace.com/api/v1

# SES non-send calls per second per AWS account, and the first retry's wait.
# SES_API_RATE_PER_SECOND=1
# SES_API_RETRY_BASE_MS=1000

# Seed. `pnpm dev:all` runs this on an empty database. The values below stand up a local
# development install on the mock provider, which accepts every send and delivers nothing — change all of them for a real
# deployment, starting with ADMIN_PASSWORD and SEED_PROVIDER_ADAPTER.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-anything-real
ADMIN_NAME=
SEED_ORGANIZATION_NAME=Default
SEED_ORGANIZATION_SLUG=default
SEED_PROVIDER_ADAPTER=mock
SEED_PROVIDER_NAME=primary
# JSON, validated against the adapter's credentials schema.
# ses: {"accessKeyId":"","secretAccessKey":"","region":"us-west-2"}
# mailpace: {"serverToken":"","organizationToken":""}
# mock: {}
SEED_PROVIDER_CREDENTIALS={}
# JSON, non-secret provider config. mailpace: {"webhookPublicKey":""}
SEED_PROVIDER_SETTINGS={}
SEED_PROVIDER_CONCURRENCY=4
SEED_DOMAIN=example.com
SEED_KEY_NAME=bootstrap
SEED_KEY_MODE=live

# pnpm reset:admin. Pass them on the command line rather than leaving a password here.
# RESET_ADMIN_EMAIL=
# RESET_ADMIN_PASSWORD=

# Pouch's own mail — password resets, confirmations, layout previews, operator digests — sends from the
# system mail domain, set in Admin settings → General. Unset, it's the first verified domain, so a fresh
# install needs nothing here.

# SMTP ingress (the `mail-smtp` service). Unset TLS paths mean 587 starts with AUTH disabled in
# production — see docs/engineering.md, "SMTP TLS".
# Ports above 1024 so they bind without root; production sets 587.
SMTP_SUBMISSION_PORT=2587
# Implicit TLS (465) is off unless set, and needs the TLS paths too. Self-host option only.
# SMTP_IMPLICIT_TLS_PORT=2465
SMTP_HEALTH_PORT=3102
SMTP_TLS_HOST=
SMTP_TLS_CERT_PATH=
SMTP_TLS_KEY_PATH=
SMTP_MAX_CLIENTS=100
SMTP_MAX_MESSAGE_BYTES=31457280
SMTP_SOCKET_TIMEOUT_MS=60000

# Worker loop cadence and batch sizes. Every one has the default shown; set them only to tune.
WORKER_WEBHOOK_INTERVAL_MS=2000
WORKER_WEBHOOK_BATCH=50
WORKER_RETENTION_INTERVAL_MS=60000
WORKER_RETENTION_BATCH=500
WORKER_ABANDON_INTERVAL_MS=60000
WORKER_ABANDON_BATCH=500
WORKER_TEST_MODE_INTERVAL_MS=2000
WORKER_TEST_MODE_BATCH=500
WORKER_TEST_MODE_DELAY_MS=5000
WORKER_EXPORT_INTERVAL_MS=5000
WORKER_EXPORT_BATCH=5
WORKER_EXPORT_EXPIRE_BATCH=20
WORKER_INBOUND_RETENTION_INTERVAL_MS=60000
WORKER_INBOUND_RETENTION_BATCH=500
WORKER_ADDRESS_EXPIRY_INTERVAL_MS=60000
WORKER_ADDRESS_EXPIRY_BATCH=500
WORKER_FORWARD_INTERVAL_MS=5000
WORKER_FORWARD_BATCH=50
WORKER_LIST_CONFIRM_INTERVAL_MS=10000
WORKER_LIST_CONFIRM_BATCH=50
WORKER_DIGEST_INTERVAL_MS=3600000
WORKER_HEALTH_CHECK_INTERVAL_MS=300000
WORKER_BLOCKLIST_INTERVAL_MS=3600000
WORKER_BLOCKLIST_BATCH=500
WORKER_DOMAIN_STATS_INTERVAL_MS=3600000
WORKER_ACTIVITY_RETENTION_INTERVAL_MS=3600000
WORKER_ACTIVITY_RETENTION_BATCH=1000
WORKER_HEALTH_WATCH_INTERVAL_MS=60000
WORKER_VERIFY_VERIFIED_RECHECK_MS=86400000

# Messages to distinct recipients, within one rendered body, before a send is treated as bulk.
BULK_FANOUT_THRESHOLD=200
# Object storage key prefix. Exports go to `<prefix>-exports`.
STORAGE_KEY_PREFIX=bodies
# How long an MCP watch call holds the connection open.
MCP_WATCH_TIMEOUT_MS=55000
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4

# Typo-tolerant dashboard search. Unset MEILISEARCH_URL means off: search is Postgres alone, as before.
# Point it at Meilisearch or a proxy that speaks its API, with a key scoped to MEILISEARCH_INDEX_PREFIX.
# A search that takes longer than MEILISEARCH_TIMEOUT_MS answers from Postgres. Fill the index with
# scripts/search-reindex.ts. See docs/decisions.md, "Search copies the fields it searches, never a body".
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_PREFIX=pouch_
MEILISEARCH_TIMEOUT_MS=300

# Integration tests. Point at the compose Postgres; Redis is REDIS_URL under a per-checkout key prefix.
TEST_DATABASE_URL=postgresql://mail:mail@localhost:5440/mail_test
# The compose Meilisearch. Unset skips the tests that need a live index; the fallback tests always run.
TEST_MEILISEARCH_URL=http://127.0.0.1:7710
TEST_MEILISEARCH_API_KEY=pouch-development-meili-key
# Proves the suite doesn't depend on the app and database clocks agreeing.
TEST_CLOCK_SKEW_MS=
# pnpm release:sdk publishes as the `npm login` account unless this is set. Keep it in a password manager, not here.
# NPM_TOKEN=
# pnpm test:load: messages, worker and provider concurrency, mock provider latency and a file for the numbers.
# LOAD_MESSAGES=2000
# LOAD_WORKER_CONCURRENCY=8
# LOAD_PROVIDER_CONCURRENCY=4
# MOCK_SEND_LATENCY_MS=120
# LOAD_BATCH=2000
# LOAD_EVENTS=2000
# LOAD_WEBHOOKS=1000
# LOAD_REPORT=

# Resolvers the domain screen checks published DNS against. Comma-separated IPs.
# Defaults to 1.1.1.1 and 8.8.8.8; set this to reach an internal or restricted network's DNS.
DNS_RESOLVERS=

# The @uikit shadcn registry (components.json). Only `pnpm uikit` needs it; the kit's files are committed.
UIKIT_REGISTRY_URL=
